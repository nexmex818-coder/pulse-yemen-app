<?xml version='1.0' encoding='utf-8'?>
<widget id="com.pulse.yemen" version="1.1.3" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>نبض الصرف</name>
    <description>تطبيق متابعة أسعار الصرف في اليمن</description>
    <author email="dev@aden.com">Aden Developer</author>
    <content src="index.html" />
    <plugin name="cordova-plugin-admob-plus" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="https://raw.githubusercontent.com/*" />
    <preference name="AndroidXEnabled" value="true" />
    <preference name="BackgroundColor" value="#121212" />
    <preference name="gradleVersion" value="8.0" />
    <preference name="android-minSdkVersion" value="22" />
</widget>
